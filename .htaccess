# Доставка цветов — витрина + админ-панель
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Критик security re-check LOW: www-дубль → canonical apex (один хоп, https)
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://flowers.interfood-catering.ru%{REQUEST_URI} [R=301,L]

# Критик security (4/10): http→https 301 (кроме ACME-валидации)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{REQUEST_URI} !^/\.well-known
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# /admin без слэша: mod_dir за nginx делает 301 с http Location (утечка scheme).
# Явный абсолютный редирект на https — один хоп, без http-утечки.
RewriteRule ^admin$ https://flowers.interfood-catering.ru/admin/ [R=301,L]

# Физические файлы и каталоги отдаём как есть
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Корневые пути иконок по умолчанию (браузеры/боты просят /favicon.ico без links-тега)
RewriteRule ^favicon\.ico$ img/favicon.ico [L]
RewriteRule ^favicon\.png$ img/favicon-32.png [L]
RewriteRule ^apple-touch-icon(\.precomposed)?\.png$ img/favicon-180.png [L]

# Sitemap: robots.txt ссылается на /sitemap.xml, генератор — sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# API
RewriteRule ^api/orders$ api/orders.php [L]
RewriteRule ^api/payment/create$ api/payment-create.php [L]
RewriteRule ^api/csp-report\.php$ api/csp-report.php [L]
# Неизвестный /api/* — честный JSON 404, а не HTML главной (критик security)
RewriteRule ^api/ api/404.php [L]

# Карточка товара
RewriteRule ^product/([a-z0-9\-]+)$ product.php?slug=$1 [L,QSA]

# Юридические страницы (переименованные: обход opcache без validate_timestamps)
RewriteRule ^offer$ offer_new.php [L,QSA]
RewriteRule ^policy$ policy_new.php [L,QSA]
RewriteRule ^track$ track.php [L,QSA]

# Страница благодарности
RewriteRule ^order-thanks$ order-thanks.php [L,QSA]

# Всё остальное — честный 404 (критик security: раньше soft-200 главной на любой мусор)
RewriteCond %{REQUEST_URI} !^/404\.php$
RewriteRule ^ 404.php [L]
ErrorDocument 404 /404.php
</IfModule>

# Конфиг и база не отдаются из веба
<FilesMatch "\.(db|sqlite3?)$">
Require all denied
</FilesMatch>
<Files "config.php">
Require all denied
</Files>
Options -Indexes
