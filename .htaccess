# Доставка цветов — витрина + админ-панель
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Критик security re-check LOW: www-дубль → canonical apex (один хоп, https)
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://flowers.interfood-catering.ru%{REQUEST_URI} [R=301,L]

# Критик security (4/10): http→https 301 (кроме ACME-валидации)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{REQUEST_URI} !^/\.well-known
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Покупатель-критик W42: /cart /checkout — исторические пути без страниц (404);
# оформление живёт в #order — редиректим туда, а не в тупик.
# Абсолютный https: Apache за nginx видит http и иначе льёт http-Location (как с index.php).
RewriteRule ^cart/?$ https://flowers.interfood-catering.ru/ [R=302,L]
RewriteRule ^checkout/?$ https://flowers.interfood-catering.ru/ [R=302,L]

# /admin без слэша: mod_dir за nginx делает 301 с http Location (утечка scheme).
# Явный абсолютный редирект на https — один хоп, без http-утечки.
RewriteRule ^admin$ https://flowers.interfood-catering.ru/admin/ [R=301,L]

# SEO-критик W40: /index.php — дубль главной, 301 на канонический /.
# ВАЖНО: до блока «физические файлы», иначе -f [L] отдаст index.php как есть.
# ВАЖНО 2: абсолютный https — Apache за nginx видит http и иначе льёт http-Location.
RewriteCond %{THE_REQUEST} ^[A-Z]+\ /index\.php[?\ ]
RewriteRule ^index\.php$ https://flowers.interfood-catering.ru/ [R=301,L]

# Физические файлы и каталоги отдаём как есть
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Корневые пути иконок по умолчанию (браузеры/боты просят /favicon.ico без links-тега)
RewriteRule ^favicon\.ico$ img/favicon.ico [L]
RewriteRule ^favicon\.png$ img/favicon-32.png [L]
RewriteRule ^apple-touch-icon(\.precomposed)?\.png$ img/favicon-180.png [L]

# Sitemap: robots.txt ссылается на /sitemap.xml, генератор — sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# API
RewriteRule ^api/orders$ api/orders.php [L]
RewriteRule ^api/promo$ api/promo.php [L]
RewriteRule ^api/payment/create$ api/payment-create.php [L]
RewriteRule ^api/csp-report\.php$ api/csp-report.php [L]
# Неизвестный /api/* — честный JSON 404, а не HTML главной (критик security)
RewriteRule ^api/ api/404.php [L]

# Occasion-лендинги (SEO-критик: intent-трафик свадьбы/др/траур)
RewriteRule ^occasion/([a-z0-9\-]+)$ occasion.php?slug=$1 [L,QSA]

# W97-fixB3b (B3b-1c): посадочные страницы категорий /category/{slug}
# (SEO-major: категории получают собственные URL вместо вкладки без индексации)
RewriteRule ^category/([a-z0-9\-]+)/?$ category.php?slug=$1 [L,QSA]

# Карточка товара
RewriteRule ^product/([a-z0-9\-]+)/$ https://flowers.interfood-catering.ru/product/$1 [R=301,L]
RewriteRule ^product/([a-z0-9\-]+)$ product.php?slug=$1 [L,QSA]

# Юридические страницы (переименованные: обход opcache без validate_timestamps)
RewriteRule ^offer$ offer_new.php [L,QSA]
RewriteRule ^policy$ policy_new.php [L,QSA]
RewriteRule ^track$ track.php [L,QSA]

# Помощь (W96: красивый URL вместо /help.php). W97-fixB3a: инструкция владельца
# переехала под админку (/admin/help.php — кука сессии живёт только в path=/admin),
# старый публичный /help — 301. Абсолютный https: Apache за nginx видит http и
# иначе льёт http-Location (как с index.php).
RewriteRule ^help$ https://flowers.interfood-catering.ru/admin/help.php [R=301,L,QSA]

# Страница благодарности
RewriteRule ^order-thanks$ order-thanks.php [L,QSA]

# Всё остальное — честный 404 (критик security: раньше soft-200 главной на любой мусор)
RewriteCond %{REQUEST_URI} !^/404\.php$
RewriteRule ^ 404.php [L]
ErrorDocument 404 /404.php
</IfModule>

# Конфиг и база не отдаются из веба
<FilesMatch "\.(db|sqlite3?)$">
Require all denied
</FilesMatch>
# Security-критик W40: fallback-письма и логи (ФИО/телефон/IP) не должны отдаваться из веба
<FilesMatch "\.(eml|log|txt~)$">
Require all denied
</FilesMatch>
RedirectMatch 410 ^/state/
RedirectMatch 410 ^/admin/state/
<Files "config.php">
Require all denied
</Files>
Options -Indexes

# SEO-критик W86: Cache-Control статики (прод был без него — повторные визиты revalidate всё).
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType application/font-woff2 "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/svg+xml "access plus 7 days"
# W96-fix3a (T3b): CSS/JS — год (было 1 час): ссылки версионированы ?v=md5 (head.php, T4),
# смена файла меняет URL — долгий кэш безопасен. Картинки НЕ тронуты.
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/x-icon "access plus 7 days"
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(woff2)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(webp|jpg|jpeg|png)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>

# W96-fix3a (T3a): сжатие текстовых типов (Apache 2.4, прод SpaceWeb).
# Картинки уже сжаты форматом — не дефлейтим (усугубит CPU без выигрыша).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
# W97-fixB1 (B1-6): manifest PWA-иконок/имён — текстовый тип, сжимаем вместе с прочими
  AddOutputFilterByType DEFLATE application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE text/xml application/xml application/xhtml+xml
</IfModule>
