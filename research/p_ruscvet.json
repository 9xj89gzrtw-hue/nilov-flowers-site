, c.length);\n        }\n        return null;\n    }\n\n    function eraseCookie(name) {\n        document.cookie = name + '=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';\n    }\n</script>\n\n\t<footer class=\"footer-modern full-width layout-grid footer layout section footer-classic context-dark flower40-ru\" id=\"politics-links\">\n\t\t<div class=\"wrapper layout container footer-classic-content\">\n\t\t\t<a href=\"/politika_konfidentsialnosti\">Политика обработки персональных данных</a>\n\t\t\t<a href=\"/polzovatelskoe_soglashenie\">Согласие на обработку персональных данных</a>\n\t\t</div>\n\t</footer>\n\n\t\n<div class=\"mm-wrapper__blocker mm-slideout\"><a href=\"#mm-0\"><span class=\"mm-sronly\">Close menu</span></a></div><div class=\"mobile-header mm-slideout\">\n\t<ul>\n\t\t<li><a href=\"#mobile-menu\"><i class=\"fas fa-bars\"></i></a></li>\n\t\t<li class=\"logo\">\n\t\t\t<a href=\"/\">\n\t\t\t\t<img src=\"/assets/images/logo.svg\" alt=\"Логотип Русские цветы\">\n<!--\t\t\t\t<span>Русские <span>Цветы</span></span>-->\n\t\t\t</a>\n\t\t</li>\n\t</ul>\n\t<ul>\n\n\n\t\t<li>\n\t\t\t<a class=\"social-link\" rel=\"noopener\" href=\"https://max.ru/u/f9LHodD0cOJS0Nrk2S_Nij3SeBUMxuDcBR4jaeM59FCCmJWKfX1DgZErzgY\" target=\"_blank\">\n\t\t\t\t<!--?xml version=\"1.0\" encoding=\"UTF-8\"?-->\n<svg id=\"_РЎР»РѕР№_1\" data-name=\"РЎР»РѕР№_1\" xmlns=\"http://www.w3.org/2000/svg\" version=\"1.1\" viewBox=\"0 0 900.95 897.5\">\n  <!-- Generator: Adobe Illustrator 29.8.1, SVG Export Plug-In . SVG Version: 2.1.1 Build 2)  -->\n  <defs>\n    <style>\n      .st0 {\n        fill-rule: evenodd;\n      }\n    </style>\n  </defs>\n  <path class=\"st0\" d=\"M462.57,257.03c-99.42-5.21-177.01,63.77-194.12,171.75-14.17,89.42,10.95,198.38,32.44,203.86,9.11,2.33,31.04-14.45,47-29.49,3-2.83,7.54-3.3,11.05-1.15,24.87,15.21,53.03,26.64,84.08,28.27,102.07,5.35,192.52-74.53,197.87-176.61,5.35-102.08-76.25-191.27-178.32-196.63ZM296.08,775.42c-3.85-2.73-9.15-1.99-12.38,1.46-43.12,45.99-153.47,7